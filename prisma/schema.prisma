// Schema Prisma do CRM multi-tenant com Lead Pool centralizado

// CAMADA 1: MULTI-TENANT (Dados dos Clientes)
model Empresa {
  id            String   @id @default(cuid())
  nome          String
  cnpj          String?  @unique
  segmento      String
  plano         Plano    @default(BASICO)
  ativa         Boolean  @default(true)
  telefone      String
  email         String
  endereco      String?
  cidade        String
  configuracao  Json?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt
  
  usuarios      Usuario[]
  clientes      Cliente[]
  produtos      Produto[]
  vendas        Venda[]
  interacoes    Interacao[]
  automacoes    Automacao[]
  integracao    Integracao?
  
  @@index([segmento])
  @@index([cidade])
}

model Usuario {
  id            String   @id @default(cuid())
  empresaId     String
  nome          String
  email         String
  senha         String
  role          Role     @default(ATENDENTE)
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())
  
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  vendas        Venda[]
  interacoes    Interacao[]
  
  @@unique([email, empresaId])
  @@index([empresaId])
}

model Cliente {
  id                    String    @id @default(cuid())
  empresaId             String
  nome                  String
  telefone              String
  email                 String?
  cpfCnpj               String?
  endereco              String?
  cidade                String?
  estado                String?
  cep                   String?
  dataNascimento        DateTime?
  tags                  String[]
  observacoes           String?
  status                Status    @default(ATIVO)
  origem                String?
  valorTotal            Decimal   @default(0)
  totalCompras          Int       @default(0)
  ultimaCompra          DateTime?
  consentimentoLeadPool Boolean   @default(false)
  dataConsentimento     DateTime?
  criadoEm              DateTime  @default(now())
  atualizadoEm          DateTime  @updatedAt
  
  empresa               Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  vendas                Venda[]
  interacoes            Interacao[]
  leadPoolEntry         LeadPool?
  
  @@unique([telefone, empresaId])
  @@index([empresaId])
  @@index([telefone])
  @@index([email])
  @@index([consentimentoLeadPool])
}

model Produto {
  id            String   @id @default(cuid())
  empresaId     String
  nome          String
  descricao     String?
  categoria     String?
  preco         Decimal
  custoCompra   Decimal?
  margemLucro   Decimal?
  ativo         Boolean  @default(true)
  estoque       Int?
  estoqueMinimo Int?
  metadados     Json?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt
  
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  vendaItems    VendaItem[]
  
  @@index([empresaId])
  @@index([categoria])
}

model Venda {
  id                String      @id @default(cuid())
  empresaId         String
  clienteId         String
  usuarioId         String
  valorBruto        Decimal
  desconto          Decimal     @default(0)
  valorTotal        Decimal
  formaPagamento    String
  parcelas          Int?
  status            StatusVenda @default(CONCLUIDA)
  observacoes       String?
  criadoEm          DateTime    @default(now())
  
  empresa           Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cliente           Cliente     @relation(fields: [clienteId], references: [id])
  usuario           Usuario     @relation(fields: [usuarioId], references: [id])
  items             VendaItem[]
  
  @@index([empresaId])
  @@index([clienteId])
  @@index([criadoEm])
}

model VendaItem {
  id          String  @id @default(cuid())
  vendaId     String
  produtoId   String
  quantidade  Int
  precoUnit   Decimal
  subtotal    Decimal
  
  venda       Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produto     Produto @relation(fields: [produtoId], references: [id])
  
  @@index([vendaId])
}

model Interacao {
  id          String         @id @default(cuid())
  empresaId   String
  clienteId   String
  usuarioId   String?
  tipo        TipoInteracao
  canal       String?
  mensagem    String         @db.Text
  anexos      String[]
  origem      String?
  metadados   Json?
  criadoEm    DateTime       @default(now())
  
  empresa     Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cliente     Cliente        @relation(fields: [clienteId], references: [id])
  usuario     Usuario?       @relation(fields: [usuarioId], references: [id])
  
  @@index([empresaId])
  @@index([clienteId])
  @@index([criadoEm])
}

model Automacao {
  id          String          @id @default(cuid())
  empresaId   String
  nome        String
  descricao   String?
  tipo        TipoAutomacao
  ativo       Boolean         @default(true)
  gatilho     Json
  acoes       Json
  ultimaExec  DateTime?
  proximaExec DateTime?
  criadoEm    DateTime        @default(now())
  atualizadoEm DateTime       @updatedAt
  
  empresa     Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  
  @@index([empresaId])
  @@index([ativo])
  @@index([proximaExec])
}

model Integracao {
  id                    String   @id @default(cuid())
  empresaId             String   @unique
  chatwootUrl           String?
  chatwootToken         String?
  chatwootAccountId     String?
  chatwootAtivo         Boolean  @default(false)
  evolutionUrl          String?
  evolutionApiKey       String?
  evolutionInstance     String?
  evolutionAtivo        Boolean  @default(false)
  activepiecesWebhook   String?
  activepiecesAtivo     Boolean  @default(false)
  apiToken              String   @unique @default(cuid())
  webhookSecret         String   @default(cuid())
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt
  
  empresa               Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  
  @@index([apiToken])
}

// CAMADA 2: LEAD POOL CENTRALIZADO
model LeadPool {
  id                String    @id @default(cuid())
  nome              String
  telefone          String    @unique
  email             String?
  cidade            String?
  estado            String?
  empresaOrigemId   String
  clienteOrigemId   String    @unique
  segmentoOrigem    String
  totalInteracoes   Int       @default(0)
  totalCompras      Int       @default(0)
  valorTotalGasto   Decimal   @default(0)
  ultimaInteracao   DateTime?
  scoreEngajamento  Int       @default(0)
  tags              String[]
  consentimento     Boolean   @default(true)
  dataConsentimento DateTime
  fonteConsentimento String
  ativo             Boolean   @default(true)
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt
  
  clienteOrigem     Cliente   @relation(fields: [clienteOrigemId], references: [id])
  
  @@index([telefone])
  @@index([empresaOrigemId])
  @@index([segmentoOrigem])
  @@index([scoreEngajamento])
}

// ENUMS
enum Plano {
  BASICO
  INTERMEDIARIO
  PREMIUM
}

enum Role {
  ADMIN
  GERENTE
  ATENDENTE
}

enum Status {
  ATIVO
  INATIVO
}

enum StatusVenda {
  PENDENTE
  CONCLUIDA
  CANCELADA
}

enum TipoInteracao {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TELEFONE
  EMAIL
  SMS
  NOTA
}

enum TipoAutomacao {
  REATIVACAO
  POS_VENDA
  ANIVERSARIO
  FOLLOWUP
  CUSTOMIZADA
}

// CONFIGURAÇÕES
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}
